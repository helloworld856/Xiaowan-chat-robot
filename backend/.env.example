# MySQL 登录密码。地址、端口、用户名和库名填写在 system_config.json。
MYSQL_PASSWORD=

# 只在 MySQL 还没有管理员时读取。填自己设置的 6–18 字符密码。
ADMIN_INITIAL_PASSWORD=

# 管理员当前选用的厂商。
DEFAULT_MODEL_MERCHANT=

# 每个厂商保存一条记录。地址留空时读取全局配置中的厂商地址。
ADMIN_PROVIDERS='{"deepseek":{"model_name":"deepseek-v4-flash","base_url":"","api_key":null},"tongyi":{"model_name":"qwen3-max","base_url":"","api_key":null}}'
