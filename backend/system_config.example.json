// 小晚全局配置。修改后重启后端生效。
{
  // MySQL 连接设置。密码由 .env 的 MYSQL_PASSWORD 提供。
  "database": {
    // MySQL 主机名或 IP。
    "host": "localhost",
    // MySQL 端口。
    "port": 3306,
    // MySQL 登录用户名。
    "user": "root",
    // 数据库名称，允许字母、数字和下划线。
    "name": "XiaoWan",
    // MySQL 连接字符集。
    "charset": "utf8mb4"
  },
  // 小晚后端监听设置。
  "server": {
    // 后端监听地址。使用本机反向代理时通常填 127.0.0.1。
    "host": "127.0.0.1",
    // 后端监听端口。修改后同步调整反向代理。
    "port": 8000
  },
  // 聊天队列、输入与历史设置。
  "chat": {
    // 可同时执行的聊天请求数。
    "concurrency": 4,
    // 等待处理的聊天请求名额。
    "queue_size": 8,
    // 聊天排队最长等待时间，单位为秒。
    "queue_timeout": 2,
    // 单条用户消息最多允许的字符数。
    "max_message_chars": 8000,
    // 历史兼容保留项；长期记忆现由 memory 配置段控制。
    "history_compression_tokens": 100000,
    // 设为 true 时，后端启动会清空所有账号的聊天历史和摘要。
    "clear_history_on_startup": true,
    // 设为 true 时，后端启动会清空所有账号用户画像中自动记录的印象（保留手动填写的资料）。
    "clear_learned_portrait_on_startup": true
  },
  // 长期情景事件记忆、召回策略与本地向量模型设置。
  "memory": {
    // 每次聊天直接送入模型的最近对话轮数；更早原文保留在数据库不再删除。
    "recent_window_rounds": 24,
    // 后台每次提炼情景事件记忆的未归档对话轮数。
    "extract_batch_rounds": 8,
    // 每个账号最多保留的情景事件记忆条数，超出时优先清理最早的已完结低重要度记录。
    "max_episodes_per_account": 500,
    // 每轮对话固定带入的「近期进行中」事件上限。
    "ongoing_recall_limit": 3,
    // 「近期进行中」事件默认关注的天数范围。
    "ongoing_window_days": 14,
    // 每轮按相关性混合召回的历史事件上限。
    "relevant_recall_limit": 4,
    // 相关性召回的最低综合得分（0 到 1），低于此值的无关记忆不注入提示词。
    "min_relevance_score": 0.35,
    // 设为 true 时，后端启动会清空所有账号的情景事件记忆与归档水位。
    "clear_episodes_on_startup": true,
    // 本地轻量多语向量模型与混合召回权重设置。
    "embedding": {
      // 设为 true 时启用本地 ONNX 向量语义召回；缺少模型文件时自动降级为关键词检索。
      "enabled": true,
      // 设为 true 且 enabled 为 true 时，后端启动若检测到本地模型缺失会在后台自动下载。
      "auto_download": true,
      // 自动下载本地 ONNX 向量模型时使用的 HuggingFace 仓库名。
      "repo_id": "Xenova/multilingual-e5-small",
      // 下载模型时可选的 HuggingFace 镜像地址（如 https://hf-mirror.com）；留空时若官方源不可达会自动回退镜像源。
      "hf_endpoint": "",
      // 本地 ONNX 向量模型目录（相对 backend/ 或绝对路径），需包含 model.onnx 与 tokenizer.json。
      "model_dir": "models/multilingual-e5-small",
      // 查询文本编码前拼接的前缀；E5 系列模型使用 "query: "，不需要前缀的模型填 ""。
      "query_prefix": "query: ",
      // 记忆文本入库编码前拼接的前缀；E5 系列模型使用 "passage: "，不需要前缀的模型填 ""。
      "passage_prefix": "passage: ",
      // 单条文本参与向量编码的最大 token 数。
      "max_length": 256,
      // 混合召回中向量语义相似度的权重。
      "semantic_weight": 0.65,
      // 混合召回中中英文关键词重合度的权重。
      "keyword_weight": 0.2,
      // 混合召回中时间新鲜度与重要度的权重。
      "recency_weight": 0.15
    }
  },
  // 厂商默认地址、协议和可选模型。
  "models": {
    // 默认厂商，须在 providers 中出现。
    "default_provider": "deepseek",
    // 按厂商设置默认地址和可选模型。
    "providers": {
      // deepseek 厂商配置。
      "deepseek": {
        // 厂商默认 API 基础地址，含所需的路径。
        "base_url": "https://api.deepseek.com",
        // 默认接口协议。可选 openai 或 dashscope。
        "adapter": "openai",
        // 默认模型名，须包含在 models 中。
        "default_model": "deepseek-v4-flash",
        // 网页允许选择的模型名列表。
        "models": ["deepseek-v4-flash", "deepseek-v4-pro"],
        // 管理员额外可用的 API 基础地址，按完整地址匹配。默认地址自动获准。
        "admin_allowed_base_urls": []
      },
      // tongyi 厂商配置。
      "tongyi": {
        // 厂商默认 API 基础地址，含所需的路径。
        "base_url": "https://dashscope.aliyuncs.com/api/v1",
        // 默认接口协议。可选 openai 或 dashscope。
        "adapter": "dashscope",
        // 默认模型名，须包含在 models 中。
        "default_model": "qwen3-max",
        // 网页允许选择的模型名列表。
        "models": ["qwen3-max", "qwen-plus", "qwen-turbo", "qwen-flash"],
        // 管理员额外可用的 API 基础地址，按完整地址匹配。默认地址自动获准。
        "admin_allowed_base_urls": []
      }
    }
  },
  // 登录会话、密码规则与认证限流。
  "auth": {
    // 登录 Cookie 和服务端会话的有效期，单位为秒。28800 秒等于 8 小时。
    "session_ttl_seconds": 28800,
    // 注册和改密使用的密码长度规则。
    "password": {
      // 注册或改密时，新密码的最少字符数。
      "min_length": 6,
      // 注册或改密时，新密码的最多字符数，上限为 256。
      "max_length": 15
    },
    // 按客户端统计的认证限流。
    "rate_limit": {
      // 认证限流的统计窗口，单位为秒。
      "window_seconds": 60,
      // 每个客户端在窗口内的登录与改密失败额度，两者共用。
      "login_attempts": 5,
      // 每个客户端在窗口内的注册额度。
      "registration_attempts": 5,
      // 每个限流器最多跟踪的客户端数。
      "max_clients": 4096
    }
  },
  // 个人资料的校验规则。
  "profile": {
    // 网页保存昵称时允许的最多字符数，上限为 256。
    "max_nickname_chars": 32
  },
  // 新账号的初始偏好和头像。
  "defaults": {
    // 新账号聊天字号。可选 small、standard 或 large。
    "chat_font_size": "standard",
    // 新账号发送快捷键。可选 enter 或 ctrl_enter。
    "send_shortcut": "enter",
    // 新账号主题。theme0 默认白，theme1 海阔天空，theme2 夏日海岸，theme3 樱雨绵绵，theme4 晚风夜色。
    "theme": "theme0",
    // 新账号头像。可选 cat、fox、rabbit、bear、penguin、frog。
    "avatar_id": "cat"
  },
  // 模型配置的运行限制。
  "model_runtime": {
    // 管理员与普通用户共用的并行模型连接验证名额。
    "validation_concurrency": 2
  },
  // 系统日志与账号日志的轮转和启动清理。
  "logging": {
    // 单个系统或账号日志达到多少字节时轮转。
    "max_bytes": 2000000,
    // 每个日志最多保留的轮转归档份数。
    "backup_count": 3,
    // 后端最多同时打开多少个账号日志文件。
    "max_open_account_logs": 32,
    // 设为 true 时，启动会清空当前系统和账号日志，保留轮转归档。
    "clear_on_startup": true
  }
}
